---
import { Code } from "astro:components";

import { CODE_THEME } from "../lib/highlight";

interface Props {
  number: string;
  id: string;
  title: string;
  description: string;
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
  config?: string;
  lang?: "python" | "toml" | "bash";
}

const {
  number,
  id,
  title,
  description,
  before,
  after,
  beforeLabel = "Standard",
  afterLabel = "Tali",
  config,
  lang = "python",
} = Astro.props;
---

<article id={id} class="rule" data-reveal>
  <div class="rule__meta">
    <span class="rule__num">{number}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    {config && <p class="rule__config"><code>{config}</code></p>}
  </div>
  <div class="compare">
    <figure class="pane pane--before">
      <figcaption>{beforeLabel}</figcaption>
      <Code code={before} lang={lang} theme={CODE_THEME} />
    </figure>
    <figure class="pane pane--after">
      <figcaption>{afterLabel}</figcaption>
      <Code code={after} lang={lang} theme={CODE_THEME} />
    </figure>
  </div>
</article>
